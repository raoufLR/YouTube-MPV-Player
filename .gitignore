# Build output
dist/
build/
# Spec file is tracked (needed for builds)
!*.spec

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# User data (auto-generated at runtime)
User/
Cache/
Logs/

# Large binaries (user provides their own)
mpv.exe
yt-dlp.exe

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
